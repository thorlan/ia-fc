# 10. PROMPT CHAINING COM LANGCHAIN
# Quebra uma tarefa complexa em varios prompts encadeados: a saida de
# um vira entrada do proximo.
# ============================================================
def demo_prompt_chaining_langchain():
    from langchain_anthropic import ChatAnthropic
    from langchain_core.prompts import ChatPromptTemplate
    from langchain_core.output_parsers import StrOutputParser
    from langchain_core.runnables import RunnablePassthrough

    llm = ChatAnthropic(model=MODEL, api_key=os.environ.get("ANTHROPIC_API_KEY", ""))

    contrato = """\
Contrato de prestacao de servicos entre Empresa X e Fornecedor Y.
Vigencia de 12 meses, renovacao automatica salvo aviso com 30 dias de
antecedencia. Multa por rescisao antecipada de 20% do valor restante.
Fornecedor nao se responsabiliza por atrasos causados por terceiros.
Pagamento em ate 45 dias apos emissao de nota fiscal.
"""

    # Etapa 1: extrair dados estruturados do contrato
    prompt_extracao = ChatPromptTemplate.from_template(
        "Extraia em topicos os pontos-chave deste contrato (vigencia, "
        "renovacao, multas, responsabilidades, prazo de pagamento):\n\n{contrato}"
    )
    # Etapa 2: resumir riscos com base nos pontos extraidos
    prompt_riscos = ChatPromptTemplate.from_template(
        "Com base nestes pontos do contrato:\n\n{pontos}\n\n"
        "Liste os riscos para a Empresa X, do mais para o menos critico."
    )
    # Etapa 3: gerar parecer final combinando pontos + riscos
    prompt_parecer = ChatPromptTemplate.from_template(
        "Pontos do contrato:\n{pontos}\n\nRiscos identificados:\n{riscos}\n\n"
        "Escreva um parecer final de 1 paragrafo: assinar como esta, "
        "renegociar, ou nao assinar -- e por que."
    )

    parser = StrOutputParser()
    extracao_chain = prompt_extracao | llm | parser

    cadeia_completa = (
        RunnablePassthrough.assign(pontos=extracao_chain)
        | RunnablePassthrough.assign(riscos=(prompt_riscos | llm | parser))
        | RunnablePassthrough.assign(parecer=(prompt_parecer | llm | parser))
    )

    resultado = cadeia_completa.invoke({"contrato": contrato})

    print("=== Pontos extraidos (etapa 1) ===")
    print(resultado["pontos"])
    print("\n=== Riscos (etapa 2) ===")
    print(resultado["riscos"])
    print("\n=== Parecer final (etapa 3) ===")
    print(resultado["parecer"])



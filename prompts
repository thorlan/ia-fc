# 9. IDENTIFICANDO BUGS COM ReAct
# Loop hipotese -> teste (roda o codigo) -> observacao -> nova
# hipotese, ate isolar a causa raiz.
# ============================================================
def demo_react_bugs():
    codigo_com_bug = '''
def calcular_media(notas):
    total = 0
    for n in notas:
        total += n
    return total / len(notas)

def calcular_media_turma(alunos):
    # alunos = {"nome": [notas]}
    medias = {}
    for nome, notas in alunos.items():
        medias[nome] = calcular_media(notas)
    return medias

alunos = {"Ana": [8, 9, 7], "Bruno": [], "Carla": [6, 7, 8]}
print(calcular_media_turma(alunos))
'''

    def executar_codigo(codigo: str) -> str:
        with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as f:
            f.write(codigo)
            caminho = f.name
        resultado = subprocess.run(
            ["python3", caminho], capture_output=True, text=True, timeout=10
        )
        return f"STDOUT:\n{resultado.stdout}\nSTDERR:\n{resultado.stderr}"

    ferramentas = {"executar_codigo": executar_codigo}
    tools_schema = [{
        "name": "executar_codigo",
        "description": "Executa um trecho de codigo Python e retorna stdout/stderr.",
        "input_schema": {
            "type": "object",
            "properties": {"codigo": {"type": "string"}},
            "required": ["codigo"],
        },
    }]

    mensagens = [{
        "role": "user",
        "content": (
            "O codigo abaixo tem um bug. Formule uma hipotese, use a "
            "ferramenta executar_codigo para testar (rode o codigo "
            "original e depois versoes corrigidas), observe o "
            "resultado e repita ate encontrar e corrigir o bug. No "
            "final, mostre o codigo corrigido completo.\n\n" + codigo_com_bug
        ),
    }]

    for passo in range(6):
        resp = client.messages.create(
            model=MODEL, max_tokens=800, tools=tools_schema, messages=mensagens,
        )
        mensagens.append({"role": "assistant", "content": resp.content})

        tool_calls = [b for b in resp.content if b.type == "tool_use"]
        if not tool_calls:
            texto = "".join(b.text for b in resp.content if b.type == "text")
            print(f"\n[Conclusao]\n{texto}")
            return

        resultados = []
        for call in tool_calls:
            print(f"[Passo {passo}] Testando hipotese, rodando codigo...")
            resultado = ferramentas[call.name](**call.input)
            print(f"[Passo {passo}] Observacao:\n{resultado}")
            resultados.append({"type": "tool_result", "tool_use_id": call.id, "content": resultado})

        mensagens.append({"role": "user", "content": resultados})

    print("Nao concluido dentro do limite de passos.")


